# ---------------------------------------------------------------
# Gartenprofi Baleca  ·  Hostinger / LiteSpeed
# Vor dem Livegang prüfen: Domain und www-Variante unten anpassen.
# ---------------------------------------------------------------

Options -Indexes
DirectoryIndex index.html

# --- HTTPS erzwingen und auf die Variante ohne www vereinheitlichen ---
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Alte Adressen mit /site/ auf die saubere Adresse ohne /site/.
  # Muss hier stehen: fuer Anfragen in diesen Ordner gilt nur diese Datei.
  RewriteCond %{THE_REQUEST} \s/site/([^?\s]*) [NC]
  RewriteRule ^ /%1 [R=301,L]
</IfModule>

# --- Protokolldatei des Veroeffentlichens nicht ausliefern ---
# Der GitHub-Ablauf legt sie im Webverzeichnis ab. Sie enthaelt nur
# Dateinamen und Pruefsummen, gehoert aber trotzdem nicht ins Netz.
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

# --- Eigene Fehlerseite ---
# Steht in der .htaccess an der Wurzel des Repositorys (/site/404.html),
# weil Hostinger das ganze Repository nach public_html spielt.

# --- Kompression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/javascript image/svg+xml
</IfModule>

# --- Zwischenspeicher ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 month"
  ExpiresByType image/jpeg                "access plus 1 month"
  ExpiresByType image/png                 "access plus 1 month"
  ExpiresByType image/svg+xml             "access plus 1 month"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType video/mp4                 "access plus 1 month"
</IfModule>
<IfModule mod_headers.c>
  # CSS und JS tragen in den HTML-Dateien eine Versionsnummer (?v=JJJJMMTT).
  # Nur deshalb duerfen sie ein Jahr lang als unveraenderlich gelten: bei
  # jeder Aenderung die Nummer in allen vier HTML-Dateien hochzaehlen, sonst
  # sehen wiederkehrende Besucher die alte Fassung. Schriften aendern sich nie.
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Bilder und Videos werden beim Tauschen unter demselben Namen ueberschrieben
  # (so ist schon das Rasenbild dreimal getauscht worden). Deshalb nur 30 Tage
  # und ohne immutable, dann kommt ein neues Bild spaetestens nach einem Monat an.
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # --- Sicherheits-Kopfzeilen ---
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  # HSTS erst einschalten, wenn HTTPS nachweislich überall läuft:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>
